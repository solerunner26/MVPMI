# Development only. Never use real community contacts yet.
DEVELOPMENT_MODE=true
PORT=3000
DB_PATH=data/community.sqlite
# Required on first launch: 10+ characters with upper/lowercase, number and symbol.
ADMIN_PASSWORD=
# Required on first launch: choose your own four digits.
ADMIN_GATE_CODE=
# Set true for an HTTPS deployment. False only for local HTTP development.
COOKIE_SECURE=false
# Admin password recovery is offline: a recovery code is issued once at the
# first sign-in and can be regenerated from the Security tab. No SMS, OTP or
# delivery service is configured or needed.
