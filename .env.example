# Local testing: DEVELOPMENT_MODE=true. Live site: see docs/DEPLOY_GODADDY.md.
DEVELOPMENT_MODE=true
PORT=3000
DB_PATH=data/community.sqlite
# The Main Admin is seeded from config/main-admin.env (see
# config/main-admin.env.example) or from MAIN_ADMIN_* lines here. Never commit
# real values: .env and config/main-admin.env are excluded from git.
# true for HTTPS (required when DEVELOPMENT_MODE=false). false only for local HTTP.
COOKIE_SECURE=false
# Behind cPanel/Passenger or another reverse proxy: 1 (set automatically under Passenger).
TRUST_PROXY=
# Contact for browser push services, e.g. mailto:you@example.org
VAPID_SUBJECT=
# The member PIN lock is on by default. Only switch off for automated tests.
REQUIRE_APP_LOCK=true
# A forgotten Main Admin password is reset on the server only:
#   node scripts/reset-main-admin.js
# Members and Village Admins who forget their PIN use "Forgot PIN?"; their
# admin shares a TEMP PIN on WhatsApp. No SMS, OTP or paid service is used.
