# /etc/mvpmi.env  (owner root:mvpmi, mode 640) — settings for the live server
NODE_ENV=production
DEVELOPMENT_MODE=false
COOKIE_SECURE=true
TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/mvpmi/community.sqlite
DOWNLOAD_DIR=/var/lib/mvpmi/downloads
PUBLIC_URL=https://samaj.example.com
VAPID_SUBJECT=https://samaj.example.com
# First start only: creates the main administrator (change later in the app).
ADMIN_PASSWORD=
ADMIN_GATE_CODE=
# Google Drive backup (see docs/DEPLOY.md). Keep the passphrase safe:
# it is needed to open any backup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKUP_PASSPHRASE=
# Shown on /privacy and /delete-account (optional).
PRIVACY_CONTACT_EMAIL=
