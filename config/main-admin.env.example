# Main Admin seed (Section 2) — copy to config/main-admin.env on the SERVER
# (or put the same lines in /etc/mvpmi.env). That file is excluded from git.
# Used only once, when the database has no Main Admin yet. After that the Main
# Admin changes the password inside the app (Profile → Change Password); a
# forgotten password is reset on the server with:
#   node scripts/reset-main-admin.js
MAIN_ADMIN_NAME=
# Optional Gujarati spelling of the name (shown in Gujarati mode).
MAIN_ADMIN_NAME_GU=
MAIN_ADMIN_MOBILE=
MAIN_ADMIN_VILLAGE=
MAIN_ADMIN_LOCATION=
# First-login-only password, at least 4 characters (any characters, e.g. letters, numbers and
# symbols). It works for ONE login: the app then asks the Main Admin to choose
# his own new password (new + re-enter). A server reset
# (scripts/reset-main-admin.js) is also first-login-only.
MAIN_ADMIN_PASSWORD=
